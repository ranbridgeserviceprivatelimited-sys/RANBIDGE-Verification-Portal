rules_version = '2';

// Firebase Cloud Storage security rules for RANBIDGE Verification Portal
service firebase.storage {
  match /b/{bucket}/o {

    // 1. Certificate files, generated PDFs & images
    match /certificates/{allPaths=**} {
      allow read, write: if true;
    }

    // 2. Event certificate backgrounds, templates, and logos
    match /events/{allPaths=**} {
      allow read, write: if true;
    }

    // 3. User document uploads, student photos, proof files
    match /uploads/{allPaths=**} {
      allow read, write: if true;
    }

    // 4. Universal catch-all for any uploaded assets
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
